def scrape_environmental_jobs(url, search_term="ecologist"):
    options = webdriver.ChromeOptions()
    # options.add_argument("--headless")  # Optional: For headless browsing (comment this out for interactive inspection)

    try:
        driver = webdriver.Chrome(options=options)
        driver.get(url)

        # 1. Search (if needed)
        search_bar = WebDriverWait(driver, 10).until(
            EC.presence_of_element_located((By.ID, "keyword"))  # Example ID, inspect the website
        )
        search_bar.send_keys(search_term)
        search_button = driver.find_element(By.ID, "keyword-search-form")  # Example ID, inspect the website
        search_button.click()

        # 2. Wait for job listings to load (CRITICAL)
        job_listings_loaded = WebDriverWait(driver, 20).until(  # Increased timeout
